# syntax=docker/dockerfile:1

##################
# Frontend build #
##################

# Build the frontend.
FROM node:26-alpine AS frontend
WORKDIR /app

# Install dependencies and build the frontend.
# Type-checking runs in CI, and generated API types are type-only imports, so Vite does not need them.
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
RUN npx vite build

########################################
# Debian slim image: build and runtime #
########################################

# Install the Rust and SQLite build tools.
FROM rust:1.99.1-slim-trixie AS builder-debian
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Compile the dependencies with a placeholder app, so they stay cached until Cargo.toml or Cargo.lock changes.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN mkdir src \
    && printf '//! Placeholder for compiling dependencies.\nfn main() {}\n' > src/main.rs \
    && cargo build --locked --release \
    && rm -rf src

# Build the Rust application with the frontend embedded.
# Touching main.rs makes Cargo rebuild the app instead of reusing the placeholder.
COPY build.rs ./
COPY src ./src
COPY sql ./sql
COPY --from=frontend /app/web/dist ./web/dist
RUN touch src/main.rs && cargo build --locked --release

# Prepare the Debian runtime and data directory.
FROM debian:trixie-slim AS debian-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /data \
    && chown 10001:10001 /data

# Copy the application binary.
COPY --from=builder-debian /app/target/release/justgoto /usr/local/bin/justgoto

# Configure and start the application as a non-root user.
ENV HOST=0.0.0.0 \
    PORT=3000 \
    DB_PATH=/data/db.sqlite3
WORKDIR /data
USER 10001:10001
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/justgoto"]
