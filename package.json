{
	"name": "justgoto-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"generate:api": "tsx scripts/generate-api.ts",
		"generate:api:check": "tsx scripts/generate-api.ts --check",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"lint:rust": "cargo clippy --locked --all-targets --all-features -- -D warnings",
		"format": "prettier web scripts README.md SECURITY.md package.json tsconfig.json vite.config.ts eslint.config.js --write",
		"format:check": "prettier web scripts README.md SECURITY.md package.json tsconfig.json vite.config.ts eslint.config.js --check",
		"format:rust": "cargo fmt --all",
		"format:rust:check": "cargo fmt --all --check",
		"format:all": "npm run format && npm run format:rust",
		"check": "npm run typecheck && npm run lint && npm run format:check",
		"check:rust": "npm run format:rust:check && npm run lint:rust && cargo test --locked",
		"check:all": "npm run build && npm run check:rust",
		"build": "npm run check && vite build",
		"build:all": "npm run build && cargo build --locked --release"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"semi": true,
		"trailingComma": "all",
		"printWidth": 100,
		"endOfLine": "lf",
		"proseWrap": "never",
		"plugins": [
			"prettier-plugin-brace-style"
		],
		"braceStyle": "stroustrup"
	},
	"engines": {
		"node": "^26.0.0"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "10.13.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-brace-style": "0.10.4",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.4"
	}
}
